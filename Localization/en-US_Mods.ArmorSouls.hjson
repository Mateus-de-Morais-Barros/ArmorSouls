Configs: {
	ArmorSoulsConfig: {
		DisplayName: Armor Souls Config

		IncludePieceDamageBonuses: {
			Label: Include Individual Piece Damage Bonuses
			Tooltip:
				'''
				Souls of armors with class-specific helmet variants (Cobalt, Mythril, Palladium, Orichalcum, Adamantite, Titanium, Chlorophyte, Shroomite, Hallowed) also grant the flat damage/critical/speed bonuses of each individual piece, not just the unique set bonus effect.
				Disable this to only grant the unique set bonus effect (e.g. mana reduction, ammo saving), keeping the souls simpler and weaker.
				'''
		}
	}
}

